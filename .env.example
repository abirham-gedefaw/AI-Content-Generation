# ---- Gemini (script, narration, translation) ----
GEMINI_API_KEY=

# ---- Cloudflare Workers AI (keyframes) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Default: FLUX.1 schnell. You can try @cf/black-forest-labs/flux-2-klein if available on your account.
CF_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell

# ---- Wan 2.2 local / Kaggle (moving shots) ----
# Leave blank to use the FFmpeg Ken Burns fallback.
WAN_DIR=
WAN_CKPT_DIR=

# ---- ACE-Step 1.5 local (music) ----
# Leave blank to use the built-in procedural score fallback.
ACESTEP_DIR=
ACESTEP_CONFIG=acestep-v15-turbo
ACESTEP_LM=acestep-5Hz-lm-0.6B

# ---- Pipeline behaviour ----
# If true, a failed model call falls back instead of stopping. Set false for strict production runs.
ALLOW_FALLBACKS=true
